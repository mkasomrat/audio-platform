# ===== PUBLIC (safe for the browser) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# ===== SERVER-ONLY SECRETS (never prefix with NEXT_PUBLIC_) =====
SUPABASE_SERVICE_ROLE_KEY=

# ===== PHASE 2 (optional until Phase 2) =====
LIVEKIT_URL=   # wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ===== PHASE 2 recording storage (optional; see FREE_TIER_LIMITATIONS.md) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=   # any S3-compatible endpoint (Supabase: https://REF.supabase.co/storage/v1/s3)
STORAGE_REGION=   # Supabase: region shown on Storage > S3 settings. R2: auto

# ===== OPTIONAL CAPACITY OVERRIDES (defaults in src/config/quotas.ts) =====
# MAX_LISTENERS=90
# MAX_SPEAKERS=5
# MAX_BROADCASTERS=1
# MAX_BROADCAST_DURATION_MIN=120
